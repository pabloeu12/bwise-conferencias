# Copie este arquivo para .env.local e ajuste conforme o ambiente.
# Em desenvolvimento local, pode deixar em branco (o app usa http://127.0.0.1:8000 por padrão).
# Em produção (Vercel), defina esta variável apontando para a URL pública do backend (Render).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
